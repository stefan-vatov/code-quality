{
  "name": "ts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "root": "ts",
  "sourceRoot": "ts/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "pnpm --dir ts build",
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "command": "pnpm --dir ts check"
    },
    "lint": {
      "command": "pnpm run lint:ci"
    },
    "test": {
      "command": "pnpm exec vitest run --config vitest.config.mts --passWithNoTests ts"
    },
    "codemod-quality": {
      "command": "pnpm run test:codemod-quality"
    },
    "pack": {
      "command": "pnpm --dir ts build && mkdir -p dist/packages && pnpm --dir ts pack --pack-destination ../dist/packages",
      "outputs": ["{workspaceRoot}/dist/packages"]
    }
  }
}
